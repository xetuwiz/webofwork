# Copy to .env and fill in. Never commit .env.

# Required. Shared with the .NET side; both directions use it.
INTERNAL_API_KEY=change-me-to-a-long-random-string

APP_ENV=development
DOTNET_BASE_URL=https://localhost:5001
DOTNET_READ_TIMEOUT_SECONDS=5
DOTNET_CALL_TIMEOUT_SECONDS=30
MAX_INTERNAL_READS_PER_WORKFLOW=20

# Provider chain, in fallback order. "fixture" serves recorded responses and needs
# no keys -- useful for CI and for a first run.
LLM_PROVIDER_CHAIN=fixture
LLM_ALLOW_FIXTURE_FALLBACK=true

# Real providers. Comma-separated; order is the rotation order.
# LLM_PROVIDER_CHAIN=gemini,groq,openrouter
# LLM_GEMINI_API_KEYS=
# LLM_GROQ_API_KEYS=
# LLM_OPENROUTER_API_KEYS=

LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_CALLS_PER_WORKFLOW=15
LLM_REQUEST_TIMEOUT_SECONDS=30

LOG_LEVEL=INFO
