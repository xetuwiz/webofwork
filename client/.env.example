# Base URL MUST end in /api - every client path is relative to it
# (e.g. axiosInstance.get("/auth/login/") -> <base>/auth/login/).
# The dev API is HTTPS on a self-signed certificate, so the browser will warn
# on first load; click through once and it is remembered for the session.
VITE_BASE_URL=https://localhost:5001/api

# WebSocket base. The server mounts its bridge at /ws, with chat at
# /ws/chat/{roomId}/ and notifications at /ws/notifications/.
# Must be wss:// to match the HTTPS dev server.
VITE_WS_URL=wss://localhost:5001/ws

# Cloudinary: only the cloud name and unsigned preset. Never put the API
# secret in a VITE_ var - it ships to the browser.
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET

# Google OAuth web client ID (must match Google:ClientId on the server).
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# PayPal sandbox client ID. There is deliberately no VITE_ var for the
# PayPal secret - the server holds it.
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
