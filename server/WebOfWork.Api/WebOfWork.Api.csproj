<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- API Explorer + Swagger (0.5) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />


    <!-- Postgres + EF Core 8 (0.3) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- JWT + BCrypt (0.4) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- Google OAuth — token verification for Google login (Phase 3) -->
    <PackageReference Include="Google.Apis.Auth" Version="1.76.0" />

    <!-- Serilog (0.5) -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Redis + Hangfire (0.6) -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.15" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.9" />
    <!-- Health checks — DB + Redis (Phase 1 step 1.7) -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.2" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />

    <!-- Cloudinary + PayPal (0.7) -->
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="PayPalCheckoutSdk" Version="1.0.4" />

    <!-- FluentValidation (0.8) -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />

    <!-- MailKit (0.9) -->
    <PackageReference Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      `CopyToPublishDirectory` is the load-bearing half.

      The templates were declared with `CopyToOutputDirectory` only, which is why
      they reached `bin/Release/net8.0/Templates` and then stopped there:
      `dotnet publish` builds a different item set, and content that does not
      opt into it is dropped. So `dotnet publish` produced a tree with no
      `Templates/` directory at all, the deploy tarball carried none, and every
      OTP email died in the background job with

          System.IO.FileNotFoundException: Email template not found.
          File name: '/var/www/webofwork-api/Templates/Email/OtpEmail.cshtml'

      while `POST /api/auth/send-otp/` still returned 200 "OTP sent to your
      email", because the send runs through Hangfire after the response is
      written. Registration, resend, account deletion and password reset all
      failed silently; nothing in the response or the request log said so.

      Both attributes are set, and the files are `None` rather than `Content`,
      because neither half alone was enough:

      - `CopyToOutputDirectory` only reached the *build* output. `dotnet publish`
        builds a different item set, so a publish had no `Templates/` at all.
      - Adding `CopyToPublishDirectory` to the existing `Content Update` also
        did not work: the metadata was visibly on the items
        (`-getItem:Content` reports it) and still no `.cshtml` reached the
        publish directory, verified from a clean `obj/`+`bin/`.
      - Re-including them as `None` works, and is checked by publishing and
        looking in the output rather than by reading the csproj.

      `Content Remove` first, because these files are default `Content` items
      for the Web SDK; including them again without removing is
      `NETSDK1022: Duplicate 'Content' items`.

      This is why every OTP mail failed silently: `SendOtp` returns 200 before
      the send happens, and the send is a Hangfire background job, so a broken
      publish looks exactly like a working endpoint.
    -->
    <Content Remove="Templates/**/*.cshtml" />
    <None Include="Templates/**/*.cshtml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Lets the test project reach `internal` members.

      Used for implementation details that are worth testing directly and have no
      public surface to reach them through: JSON extraction helpers, parsing
      guards, and the like. The alternative is a `ForTest` shim in production
      code, which adds a member to the shipping assembly purely so a test can call
      it and then has to be kept in step with the real one.

      Nothing here widens the HTTP surface: the API is still whatever the
      controllers expose.
    -->
    <InternalsVisibleTo Include="WebOfWork.Api.Tests" />
  </ItemGroup>

</Project>
